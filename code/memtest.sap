# ##############################################################################
#
# Purpose:
# - Test every memory cell in RAM on my SAP CPU computer.
#
# Strategy:
# - The program will be assembled into RAM starting at 0x00 and the CPU
#   instruction pointer will start there.
# - So long as the program is 0x80 bytes or less, it is free to scan 0xFF..0x80.
# - Then it has to move itself to himem so it can scan 0x7F..0x00.
# - Moving the program is straightforward enough; executing it from himem is
#   a whole other beast on the Radically Reduced Instruction Set Computer.  Self
#   modifying code is one solution, but is it too wordy ? ...
#
# ##############################################################################

# ###
# Initial state:
# - [PTR] is pointing to top-of-ram
# - [DST] is pointing to midpoint-of-ram
# ###
:INSPECT_PTR
# First Pass
LDA [ALLA]  # Load even-bits checker pattern into the A register for first pass of this cell.
STM [PTR]   # Write those to the memory cell pointed to by [PTR] at data-in-code later in this source file.
LDA [ALL5]  # Invalidate the A register
LDM [PTR]   # Read the memory cell contents back into the A register
SUB [ALLA]  # subtract the even bits that seeded this operation, should get zero out the bottom.
JNZ [ERR]
# Second pass, same as the first pass but work with odd bits.
LDA [ALL5]
STM [PTR]
LDA [ALLA]
LDM [PTR]
SUB [ALL5]
JNZ [ERR]
# Both passes passed, move on.
# ###
# MOOT Because above JNZ forces this be zero now.
#  LDI 0x00   # memset 0 ...
STM [PTR]  # memset 0x00->[*PTR] ... saved.
# ###
# Decrement the pointer
LDA [PTR]  # Get the current pointer value
SUB [ONE]  # Subtract one
STA [PTR]  # Save the updated pointer
SUB [HALF] # Need to check if himem pass is ending...
JC  [MOVESELF]
JMP [INSPECT_PTR]

:MOVESELF
# memcpy(src=0x7F,dst=0x00,count=0x80,step=-1)
LDI [END_OF_PROGRAM-1]
:NEXT_MEMCPY
SUB [ONE]
JC  [FINISHED_MEMCPY]
STA [PTR]
ADD [HALF]
STA [DST]
:TOP_OF_MEMCPY
LDM [PTR]
STM [DST]
LDA [PTR]
JMP [NEXT_MEMCPY]
:FINISHED_MEMCPY

# Do it all again in himem
JMP [HIMEM+128] # Jump to our himem version
:HIMEM
LDA [HALF+128]       # Reset the working pointer to mid-ram
:NEXT_HIMEM
SUB [ONE+128]  # Subtract one
STA [PTR+128]  # Finally save the updated pointer; Validate: this should leave the CF and ZF untouched!
JC  [EXIT+128] # Finished when the A register wrapped below zero.
# First Pass
:INSPECT_HIMEM
LDA [ALLA+128]  # Load even-bits checker pattern into the A register for first pass of this cell.
STM [PTR+128]   # Write those to the memory cell pointed to by [PTR] at data-in-code later in this source file.
LDA [ALL5+128]  # Invalidate the A register
LDM [PTR+128]   # Read the memory cell contents back into the A register
SUB [ALLA+128]  # subtract the even bits that seeded this operation, should get zero out the bottom.
JNZ [ERR+128]
# Second pass, same as the first pass but work with odd bits.
LDA [ALL5+128]
STM [PTR+128]
LDA [ALLA+128]
LDM [PTR+128]
SUB [ALL5+128]
JNZ [ERR+128]
STM [PTR+128]  # memset 0x00->[*PTR] ... saved.
LDA [PTR+128]
JMP [NEXT_HIMEM+128]



:EXIT               # On completion, inform the user the memory test is complete
LDI 0xAA OUT
LDI 0x55 OUT
LDI 0xAA OUT
LDI 0x55 OUT
LDI 0xAA OUT
HLT

:ERR
LDA [PTR] OUT HLT # Print the pointer value and quit

# Data Values, some for convenience, others for dedicated purpose;
# Mostly driven by the fact SUB/ADD always has A and RAM as the operands.
# SuperRISC-strategy: no inc/dec, no indirect jumps, yada yada yada.
:PTR    0xFF # First cell to test is 'top-of-ram', go down from there.
:DST    0x80 # Destination pointer for memcpy
:HALF   0x80 # Constant for arithmatic
:ONE    0x01 # Constant for arithmatic
:ALLA   0xAA # Constant for arithmatic
:ALL5   0x55 # Constant for arithmatic
:END_OF_PROGRAM


# # SAVING FOR LATER USE to end after testing lowmem.
# SUB [ONE]   # Decrement it
# JZ [EXIT]   # Quit when done
# :SAVE_DECREMENTED_ADDRESS
# STA 0xFF
# JMP [TOP_OF_LOOP_EVEN]
