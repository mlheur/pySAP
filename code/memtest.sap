JMP [START] # Jump to START

:DATA       #
0x00        # Data: a zero.

:END        # On completion, inform the user the memory test is complete
LDI 0xA5    # Load checkerboard pattern "A5" as a magic number
OUT
LDI 0x5A
OUT
LDI 0xA5
OUT
LDI 0x5A
OUT
LDI 0xA5

:OUT        #
OUT         # Print out that magic number
HLT         # Halt the computer

:START      # Main program starts here

LDI 0x00    # We need to test address 0xFF,
STA 0xFF    # Store a zero there for now.
LDI 0xFF    # Put all ones in the A register, invalidate the previous value.
LDA 0xFF    # Read back the zero we wrote there earlier
SUB [DATA]  # subtract the zero we have in data
JNZ [END]   # Print the non-zero and quit if the previous read failed.
            # otherwise, now do same rigorous testing on 0xFE
LDI 0x00    #
STA 0xFE    #
LDI 0xFF    #
LDA 0xFE    #
SUB [DATA]  #
JNZ [OUT]   #
JMP [END]   #
