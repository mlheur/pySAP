JMP [START]
:PTR_HI 0x00
:PTR_LO 0x01
:ONE  0x01
:ALLA 0xAA
:ALL5 0x55
:START
LDI 0x00
STA [PTR_HI]
LDI [END_OF_PROGRAM]
STA [PTR_LO]
:NEXT_A
LDA [ALLA]
STM [PTR_HI]
LDA [PTR_LO]
ADD [ONE]
STA [PTR_LO]
JC  [NEXT_HI]
LDA [ALL5]
STM [PTR_HI]
LDA [PTR_LO]
ADD [ONE]
STA [PTR_LO]
JC  [NEXT_HI]
JMP [NEXT_A]
:NEXT_HI
LDA [PTR_HI]
ADD [ONE]
STA [PTR_HI]
JNC [NEXT_A]
:HALT HLT
:END_OF_PROGRAM
